<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent" android:padding="24dp">
    <TextView android:text="Prayer Times" android:textSize="22sp" android:textColor="#FFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Semarang, Central Java" android:textColor="#AAA" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txt_subuh" android:textColor="#FFF" android:layout_marginTop="32dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txt_dzuhur" android:textColor="#FFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txt_ashar" android:textColor="#FFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txt_maghrib" android:textColor="#FFD700" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txt_isya" android:textColor="#FFF" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txt_next" android:layout_marginTop="40dp" android:background="#33FFFFFF" android:padding="12dp" android:textColor="#FFF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>